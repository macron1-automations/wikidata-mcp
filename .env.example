# URL of the local QLever SPARQL endpoint
# Default: http://localhost:7001/sparql
# Remote Tailscale host: http://100.96.219.81:7001/sparql
WIKIDATA_SPARQL_URL=http://localhost:7001/sparql

# Per-query timeout in milliseconds (default: 30000)
WIKIDATA_TIMEOUT_MS=30000

# Whether to enable the read-only query_sparql tool (default: true)
WIKIDATA_ALLOW_RAW_SPARQL=true

# Cache TTL for QID labels in milliseconds (default: 300000 = 5 minutes; 0 to disable)
WIKIDATA_CACHE_TTL_MS=300000
